DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PASSWORD=
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_USER=${DB_POSTGRESDB_HOST}
DB_TYPE=postgresdb

N8N_HOST=
N8N_PROTOCOL=https
N8N_PROXY_HOPS=1 #this is behind a caddy reverse proxy
N8N_INSTANCE_AI_MODEL=
N8N_INSTANCE_AI_MODEL_API_KEY=
N8N_INSTANCE_AI_SANDBOX_ENABLED=true
N8N_INSTANCE_AI_SANDBOX_PROVIDER=n8n-sandbox
N8N_INSTANCE_AI_SEARXNG_URL=http://searxng:8080
N8N_RUNNERS_AUTH_TOKEN=
N8N_RUNNERS_AUTO_SHUTDOWN_TIMEOUT=15
N8N_RUNNERS_BROKER_LISTEN_ADDRESS=0.0.0.0
N8N_RUNNERS_MODE=external
N8N_RUNNERS_TASK_BROKER_URI=http://n8n:5679
N8N_SANDBOX_SERVICE_API_KEY=
N8N_SANDBOX_SERVICE_URL=http://sandbox-api:8080
N8N_SANDBOX_VERSION=
N8N_VERSION=
N8N_WEBHOOK_URL=${N8N_PROTOCOL}://${N8N_HOST}

PGDATA=/var/lib/postgresql/data
POSTGRES_DB=${DB_POSTGRESDB_DATABASE}
POSTGRES_PASSWORD=${DB_POSTGRESDB_PASSWORD}
POSTGRES_USER=${DB_POSTGRESDB_HOST}

SANDBOX_API_KEYS=${N8N_SANDBOX_SERVICE_API_KEY}
SANDBOX_API_RUNNER_API_KEY=
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=
SANDBOX_RUNNER_API_KEYS=${SANDBOX_API_RUNNER_API_KEY}
SANDBOX_RUNNER_REGISTRATION_TOKEN=${SANDBOX_API_RUNNER_REGISTRATION_TOKEN}

SEARXNG_SECRET=
